{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_version",
    "case_id",
    "created_at",
    "tool_versions",
    "source_directory",
    "purpose",
    "scope",
    "owner",
    "analyst",
    "acquisition_authority_ref",
    "mode",
    "investigation_mandate_ref",
    "supervising_role",
    "jurisdiction",
    "synthetic",
    "lock_sha256",
    "documents",
    "framework_files"
  ],
  "properties": {
    "runtime_version": {
      "const": "0.1.0-alpha.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "jsonschema"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "jsonschema": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "source_directory": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "analyst": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "acquisition_authority_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "mode": {
      "enum": [
        "audit",
        "investigation"
      ]
    },
    "investigation_mandate_ref": {
      "type": "string"
    },
    "supervising_role": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "synthetic": {
      "type": "boolean"
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "original_relative_path",
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "original_relative_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "minItems": 1
    },
    "framework_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1
    }
  }
}
